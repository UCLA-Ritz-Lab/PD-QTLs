# ──────────────────────────────────────────────────────────────────────────────
# PPMI WGS Post-Imputation Pipeline
# Michigan Imputation Server output → filtered VCF → PLINK2 pfiles
#
# Input:  results/PPMI_WGS/imputation_results/chr_<N>.zip  (MIS output, one per chromosome)
# Output: results/ppmi_imputed_filtered.dose.vcf.gz
#         results/ppmi_imputed.pgen / .psam / .pvar
#         results/qc/post_imputation_report.txt
#
# Steps:
#   1. unzip_chrom      — unzip MIS output per chromosome, generate missing tbi
#   2. filter_rsq       — retain variants with Rsq >= RSQ_MIN
#   3. concat_chroms    — merge filtered per-chrom VCFs into one
#   4. index_final      — tabix index the merged VCF
#   5. convert_plink2   — convert to PLINK2 pgen format (dosage=DS)
#   6. qc_report        — summarise variant counts and Rsq distribution
#
# Note: MIS zip files are password-protected.
#       Set: export MIS_PASSWORD="your_password"  before running.
#
# This pipeline mirrors PEG's post_imputed pipeline. Keeping them separate
# allows independent re-runs if one cohort needs reprocessing.
# ──────────────────────────────────────────────────────────────────────────────

import os

DOWNLOADS   = "../../../results/PPMI_WGS/imputation_results"
OUT         = "../../../results/PPMI_WGS/post_imputed"
CHROMS      = list(range(1, 23))
RSQ_MIN     = 0.3
MIS_PASSWORD = os.environ.get("MIS_PASSWORD", "")


# ── Targets ───────────────────────────────────────────────────────────────────
rule all:
    input:
        f"{OUT}/ppmi_imputed_filtered.dose.vcf.gz",
        f"{OUT}/ppmi_imputed_filtered.dose.vcf.gz.tbi",
        f"{OUT}/ppmi_imputed.pgen",
        f"{OUT}/qc/post_imputation_report.txt"


# ──────────────────────────────────────────────────────────────────────────────
# Step 1: Unzip MIS output per chromosome
# MIS returns password-protected zips containing:
#   chr{N}.dose.vcf.gz           — imputed dosages
#   chr{N}.empiricalDose.vcf.gz  — genotype calls at array sites (not needed)
#   chr{N}.info.gz               — per-variant Rsq and AF metrics
# The dose.vcf.gz has no .tbi — we generate it after unzipping.
# ──────────────────────────────────────────────────────────────────────────────
rule unzip_chrom:
    input:
        zip = f"{DOWNLOADS}/chr_{{chrom}}.zip"
    output:
        vcf  = temp(f"{OUT}/unzipped/chr{{chrom}}.dose.vcf.gz"),
        tbi  = temp(f"{OUT}/unzipped/chr{{chrom}}.dose.vcf.gz.tbi"),
        info = f"{OUT}/unzipped/chr{{chrom}}.info.gz"
    log:
        f"{OUT}/logs/unzip/chr{{chrom}}.log"
    conda:
        "envs/post_imputation.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {OUT}/unzipped

        unzip -P "$MIS_PASSWORD" -o {input.zip} \
            "chr{wildcards.chrom}.dose.vcf.gz" \
            "chr{wildcards.chrom}.info.gz" \
            -d {OUT}/unzipped/ \
        2> {log}

        if [[ ! -f {output.vcf} ]]; then
            echo "ERROR: expected {output.vcf} not found after unzip" >> {log}
            exit 1
        fi

        echo "Indexing chr{wildcards.chrom}.dose.vcf.gz..." >> {log}
        tabix -p vcf {output.vcf} 2>> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 2: Filter by imputation quality (Rsq)
# R2 field in INFO column from minimac4.
# ──────────────────────────────────────────────────────────────────────────────
rule filter_rsq:
    input:
        vcf = f"{OUT}/unzipped/chr{{chrom}}.dose.vcf.gz",
        tbi = f"{OUT}/unzipped/chr{{chrom}}.dose.vcf.gz.tbi"
    output:
        vcf = temp(f"{OUT}/filtered/chr{{chrom}}.dose.vcf.gz"),
        tbi = temp(f"{OUT}/filtered/chr{{chrom}}.dose.vcf.gz.tbi")
    params:
        rsq_min = RSQ_MIN
    log:
        f"{OUT}/logs/filter_rsq/chr{{chrom}}.log"
    conda:
        "envs/post_imputation.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {OUT}/filtered

        echo "Filtering chr{wildcards.chrom} — Rsq >= {params.rsq_min}" 2> {log}

        bcftools view \
            --include 'INFO/R2 >= {params.rsq_min}' \
            --output-type z \
            --output {output.vcf} \
            {input.vcf} \
        2>> {log}

        tabix -p vcf {output.vcf} 2>> {log}

        n=$(bcftools stats {output.vcf} | grep "^SN.*number of SNPs" | cut -f4)
        echo "chr{wildcards.chrom}: $n variants retained after Rsq filter" >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 3: Concatenate all chromosomes
# ──────────────────────────────────────────────────────────────────────────────
rule concat_chroms:
    input:
        vcfs = expand(f"{OUT}/filtered/chr{{chrom}}.dose.vcf.gz", chrom=CHROMS),
        tbis = expand(f"{OUT}/filtered/chr{{chrom}}.dose.vcf.gz.tbi", chrom=CHROMS)
    output:
        vcf = f"{OUT}/ppmi_imputed_filtered.dose.vcf.gz"
    log:
        f"{OUT}/logs/concat_chroms.log"
    conda:
        "envs/post_imputation.yaml"
    threads: 4
    shell:
        """
        set -euo pipefail

        echo "Concatenating chromosomes 1-22..." 2> {log}

        bcftools concat \
            --allow-overlaps \
            --output-type z \
            --output {output.vcf} \
            --threads {threads} \
            {input.vcfs} \
        2>> {log}

        echo "Concatenation complete." >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 4: Index merged VCF
# ──────────────────────────────────────────────────────────────────────────────
rule index_final:
    input:
        vcf = f"{OUT}/ppmi_imputed_filtered.dose.vcf.gz"
    output:
        tbi = f"{OUT}/ppmi_imputed_filtered.dose.vcf.gz.tbi"
    log:
        f"{OUT}/logs/index_final.log"
    conda:
        "envs/post_imputation.yaml"
    shell:
        """
        tabix -p vcf {input.vcf} 2> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 5: Convert to PLINK2 pgen format with dosage
# dosage=DS extracts the DS (dosage) field from the imputed VCF.
# Output .pgen/.psam/.pvar replaces the old WGS-derived pfiles and is used
# by the PPMI_MQTL pipeline (update config["data"]["plink_prefix"] to point here).
# ──────────────────────────────────────────────────────────────────────────────
rule convert_plink2:
    input:
        vcf = f"{OUT}/ppmi_imputed_filtered.dose.vcf.gz",
        tbi = f"{OUT}/ppmi_imputed_filtered.dose.vcf.gz.tbi"
    output:
        pgen = f"{OUT}/ppmi_imputed.pgen",
        psam = f"{OUT}/ppmi_imputed.psam",
        pvar = f"{OUT}/ppmi_imputed.pvar"
    params:
        prefix = f"{OUT}/ppmi_imputed"
    log:
        f"{OUT}/logs/convert_plink2.log"
    conda:
        "envs/post_imputation.yaml"
    threads: 4
    shell:
        """
        set -euo pipefail

        echo "Converting to PLINK2 dosage format..." 2> {log}

        plink2 \
            --vcf {input.vcf} dosage=DS \
            --double-id \
            --make-pgen \
            --out {params.prefix} \
            --threads {threads} \
        2>> {log}

        echo "PLINK2 conversion complete." >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 6: Post-imputation QC report
# Parses .info.gz files from MIS (BGZF-compressed VCF with R2/MAF in INFO).
# ──────────────────────────────────────────────────────────────────────────────
rule qc_report:
    input:
        info_files = expand(f"{OUT}/unzipped/chr{{chrom}}.info.gz", chrom=CHROMS),
        final_vcf  = f"{OUT}/ppmi_imputed_filtered.dose.vcf.gz"
    output:
        report = f"{OUT}/qc/post_imputation_report.txt"
    log:
        f"{OUT}/logs/qc_report.log"
    conda:
        "envs/post_imputation.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {OUT}/qc

        python scripts/post_imputation_report.py \
            --info_dir  {OUT}/unzipped \
            --final_vcf {input.final_vcf} \
            --mis_qc    {DOWNLOADS}/qc_report.txt \
            --rsq_min   {RSQ_MIN} \
            --out       {output.report} \
        2> {log}

        cat {output.report}
        """
