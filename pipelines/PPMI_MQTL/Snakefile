# ──────────────────────────────────────────────────────────────────────────────
# PPMI mQTL Pipeline
# PPMI EPIC v1 methylation + HRC-imputed genotypes → stratified baseline mQTLs
# Genotypes: ../../results/PPMI_WGS/post_imputed/ppmi_imputed.{pgen,psam,pvar}
# (previously used raw WGS pfiles; imputed data gives ~10x more SNP-CpG overlap with PEG)
#
# Steps:
#   1.  prepare_datasets      — extract baseline T1 methylation, match IDs,
#                               stratify by case/control, build covariates
#   2.  extract_positions     — SNP and CpG positions for MatrixEQTL
#   3.  subset_genotypes      — PLINK2 --keep per dataset
#   4.  export_genotypes      — PLINK2 SNP-major dosage export (avoids fread OOM)
#   5.  run_mqtl              — MatrixEQTL cis + trans per dataset
#
# Key lessons applied from PEG pipeline:
#   - --export Av (SNP-major) instead of --export A (sample-major)
#   - reformat_traw.awk externalised to avoid Snakemake brace interpolation
#   - SlicedData$LoadFile() directly from bgzipped tsv — no in-R transpose
#   - rm()/gc() at every safe point to minimise peak RAM
#   - noFDRsaveMemory=TRUE in MatrixEQTL call
# ──────────────────────────────────────────────────────────────────────────────

configfile: "config.yaml"

OUT = config["out_dir"]

# ALL_DATASETS is every cohort defined in config; DATASETS is the subset this
# invocation actually analyses. The two must stay distinct: prepare_datasets is
# a single R call that writes every cohort in one pass, so its output list is
# always ALL_DATASETS. Only the per-dataset rules downstream of it are narrowed.
ALL_DATASETS = list(config["datasets"].keys())
DATASETS     = ALL_DATASETS

# Restrict the run to a subset of cohorts:
#   snakemake --config cohort=ppmi_controls
#   snakemake --config cohort=ppmi_cases,ppmi_controls
# Intended for splitting run_mqtl across cluster jobs — one cohort per
# submission parallelises better than one job doing both sequentially.
_cohort_sel = config.get("cohort")
if _cohort_sel:
    _sel = ([c.strip() for c in _cohort_sel.split(",")]
            if isinstance(_cohort_sel, str) else list(_cohort_sel))
    _unknown = [c for c in _sel if c not in ALL_DATASETS]
    if _unknown:
        raise WorkflowError(
            "Unknown cohort(s) in --config cohort=: {}. Available: {}".format(
                ", ".join(_unknown), ", ".join(ALL_DATASETS)))
    DATASETS = _sel

# ── Targets ───────────────────────────────────────────────────────────────────
rule all:
    input:
        expand("{out}/mqtl/{dataset}/cis_mqtls.txt",
               out=OUT, dataset=DATASETS),
        expand("{out}/mqtl/{dataset}/trans_mqtls.txt",
               out=OUT, dataset=DATASETS),
        f"{OUT}/positions/export_allele.txt"


# ──────────────────────────────────────────────────────────────────────────────
# Step 1: Prepare datasets
# ──────────────────────────────────────────────────────────────────────────────
rule prepare_datasets:
    input:
        beta_matrix     = config["data"]["beta_matrix"],
        cell_type_props = config["data"]["cell_type_props"],
        phenotype_file  = config["data"]["phenotype_file"],
        ancestry_pcs    = config["data"]["ancestry_pcs"],
        psam            = config["data"]["plink_prefix"] + ".psam"
    output:
        # ALL_DATASETS, not DATASETS: one R call writes every cohort, and
        # narrowing this list would leave the unselected files with no
        # producing rule for any downstream rule that still needs them.
        probe_list  = f"{OUT}/datasets/retained_probes.txt",
        meth_files  = expand("{out}/datasets/{dataset}/methylation.csv.gz",
                             out=OUT, dataset=ALL_DATASETS),
        covar_files = expand("{out}/datasets/{dataset}/covariates.csv",
                             out=OUT, dataset=ALL_DATASETS),
        keep_files  = expand("{out}/datasets/{dataset}/geno_keep.txt",
                             out=OUT, dataset=ALL_DATASETS),
        id_maps     = expand("{out}/datasets/{dataset}/id_map.csv",
                             out=OUT, dataset=ALL_DATASETS)
    conda:
        "envs/r_mqtl.yaml"
    threads:
        config["resources"]["threads_r"]
    log:
        f"{OUT}/logs/prepare_datasets.log"
    shell:
        """
        Rscript scripts/prepare_datasets.R \
            --beta_matrix     {input.beta_matrix} \
            --cell_type_props {input.cell_type_props} \
            --plink_prefix    {config[data][plink_prefix]} \
            --phenotype_file  {input.phenotype_file} \
            --ancestry_pcs    {input.ancestry_pcs} \
            --n_pcs           {config[ancestry][n_pcs]} \
            --out_dir         {OUT} \
            --meth_visit      {config[id][meth_visit]} \
            --plink_id_prefix "{config[id][plink_prefix]}" \
            --plink_id_suffix "{config[id][plink_suffix]}" \
            --cohort_case     {config[cohorts][case]} \
            --cohort_control  {config[cohorts][control]} \
            --min_sd          {config[filters][min_sd]} \
            --max_na_frac     {config[filters][max_na_fraction]} \
            --log             {log} \
        2>> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 2: Extract SNP and CpG positions
# Uses ppmi_cases as reference — shared across both datasets
# ──────────────────────────────────────────────────────────────────────────────
rule extract_positions:
    input:
        probe_list = f"{OUT}/datasets/retained_probes.txt",
        psam       = config["data"]["plink_prefix"] + ".psam"
    output:
        snp_pos  = f"{OUT}/positions/snp_positions.csv",
        cpg_pos  = f"{OUT}/positions/cpg_positions.csv",
        pvar     = f"{OUT}/positions/reference.pvar",
        keep_all = temp(f"{OUT}/positions/all_samples.keep")
    conda:
        "envs/r_mqtl.yaml"
    threads:
        config["resources"]["threads_plink"]
    log:
        f"{OUT}/logs/extract_positions.log"
    shell:
        """
        set -euo pipefail
        mkdir -p {OUT}/positions

        # Build keep file for ALL genotyped samples so MAF is computed on the
        # full 894-sample cohort, not just the ~200-sample cases subsample.
        # Using cases only dropped ~9x more variants at MAF >= 0.05 (565K vs 5.2M).
        awk -f scripts/psam_to_keep.awk {input.psam} > {output.keep_all}
        n_keep=$(wc -l < {output.keep_all})
        echo "Full genotype cohort: $n_keep samples" >> {log}
        if [ "$n_keep" -eq 0 ]; then
            echo "ERROR: empty keep file built from {input.psam}" >> {log}
            exit 1
        fi

        # --geno removed: imputed DS field missingness is not true missingness;
        # Rsq >= 0.3 filter in post-imputation already excluded poorly imputed sites.
        # --geno 0.05 was removing 4.7M variants even in the 894-sample cohort.
        plink2 \
            --pfile   {config[data][plink_prefix]} \
            --keep    {output.keep_all} \
            --hwe     {config[plink][hwe]} \
            --maf     {config[plink][maf]} \
            --max-alleles 2 \
            --snps-only \
            --set-all-var-ids '@:#:$r:$a' \
            --new-id-max-allele-len 50 missing \
            --make-just-pvar \
            --out     {OUT}/positions/reference \
            --threads {threads} \
        2>> {log}

        Rscript scripts/extract_positions.R \
            --pvar_file   {output.pvar} \
            --probe_list  {input.probe_list} \
            --out_snp_pos {output.snp_pos} \
            --out_cpg_pos {output.cpg_pos} \
            --log         {log} \
        2>> {log}
        """

# ──────────────────────────────────────────────────────────────────────────────
# Step 3: Subset genotypes per dataset
# ──────────────────────────────────────────────────────────────────────────────
rule subset_genotypes:
    input:
        keep_file = f"{OUT}/datasets/{{dataset}}/geno_keep.txt"
    output:
        pgen = f"{OUT}/genotypes/{{dataset}}.pgen",
        psam = f"{OUT}/genotypes/{{dataset}}.psam",
        pvar = f"{OUT}/genotypes/{{dataset}}.pvar"
    conda:
        "envs/tools.yaml"
    threads:
        config["resources"]["threads_plink"]
    params:
        in_prefix  = config["data"]["plink_prefix"],
        out_prefix = f"{OUT}/genotypes/{{dataset}}"
    log:
        f"{OUT}/logs/subset_genotypes/{{dataset}}.log"
    shell:
        """
        set -euo pipefail
        mkdir -p {OUT}/genotypes

        # --maf and --geno applied at extract_positions on full 894-sample cohort.
        # Only --mind and --hwe applied per-dataset to avoid over-filtering
        # in small subsamples. Allele orientation is fixed by --export-allele
        # in export_genotypes using a cohort-wide frequency file, ensuring
        # consistent allele coding across cases, controls, and cohorts.
        plink2 \
            --pfile   {params.in_prefix} \
            --keep    {input.keep_file} \
            --dosage-erase-threshold 0 \
            --mind    {config[plink][mind]} \
            --hwe     {config[plink][hwe]} \
            --max-alleles 2 \
            --snps-only \
            --set-all-var-ids '@:#:$r:$a' \
            --new-id-max-allele-len 50 missing \
            --make-pgen \
            --out     {params.out_prefix} \
            --threads {threads} \
        2> {log}
        """



# ──────────────────────────────────────────────────────────────────────────────
# Step 3b: Compute cohort-wide allele frequencies
# Used to select the most frequent ALT allele at multiallelic sites for
# --export-allele, ensuring consistent allele coding across all datasets
# (cases, controls) and across cohorts (PPMI, PEG) for meta-analysis.
# Must use the full genotype cohort, not per-dataset subsamples.
# ──────────────────────────────────────────────────────────────────────────────
rule allele_frequencies:
    input:
        psam     = config["data"]["plink_prefix"] + ".psam",
        keep_all = f"{OUT}/positions/all_samples.keep"
    output:
        afreq    = f"{OUT}/positions/cohort_allele_freq.afreq",
        export_allele = f"{OUT}/positions/export_allele.txt",
        keep_variants = f"{OUT}/positions/best_variants.txt"
    conda:
        "envs/tools.yaml"
    threads:
        config["resources"]["threads_plink"]
    log:
        f"{OUT}/logs/allele_frequencies.log"
    shell:
        """
        set -euo pipefail

        # Compute allele frequencies on full genotype cohort.
        # --set-all-var-ids forces unique chr:pos:ref:alt IDs so that
        # multiallelic sites produce separate entries in the afreq file.
        plink2 \
            --pfile {config[data][plink_prefix]} \
            --keep  {input.keep_all} \
            --set-all-var-ids '@:#:$r:$a' \
            --new-id-max-allele-len 50 missing \
            --freq \
            --out   {OUT}/positions/cohort_allele_freq \
            --threads {threads} \
        2> {log}

        # Select one record per chr:pos — the one whose own ALT has the highest
        # cohort-wide frequency — and count that record's own ALT. Using
        # cohort-wide frequencies keeps orientation consistent across cases,
        # controls, and between PPMI and PEG. See scripts/best_allele.awk for
        # why every record at a position must NOT be mapped to a shared allele.
        awk -f scripts/best_allele.awk {output.afreq} > {output.export_allele}

        # First column is the surviving variant list for --extract in
        # export_genotypes; without it PLINK2 would still export the
        # non-selected records using their default counted allele.
        cut -f1 {output.export_allele} > {output.keep_variants}

        n_af=$(grep -vc '^#' {output.afreq})
        n_ea=$(wc -l < {output.export_allele})
        echo "Allele freq records: $n_af" >> {log}
        echo "Export allele file:  $n_ea variants (one per chr:pos)" >> {log}
        echo "Dropped as non-best at a shared position: $((n_af - n_ea))" >> {log}

        # Every emitted allele must genuinely belong to its own record,
        # otherwise PLINK2 silently exports all-zero dosage.
        n_bad=$(awk -F'\t' '{{n=split($1,p,":"); if (p[n] != $2) c++}} END {{print c+0}}' \
                {output.export_allele})
        if [ "$n_bad" -ne 0 ]; then
            echo "ERROR: $n_bad export-allele entries name an allele absent from their record" >> {log}
            exit 1
        fi
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 4: Export genotypes in SNP-major format for MatrixEQTL
# --export Av writes SNPs as rows, samples as columns — no in-R transpose.
# ──────────────────────────────────────────────────────────────────────────────
rule export_genotypes:
    input:
        pgen         = f"{OUT}/genotypes/{{dataset}}.pgen",
        psam         = f"{OUT}/genotypes/{{dataset}}.psam",
        pvar         = f"{OUT}/genotypes/{{dataset}}.pvar",
        export_allele = f"{OUT}/positions/export_allele.txt",
        keep_variants = f"{OUT}/positions/best_variants.txt"
    output:
        tsv = f"{OUT}/genotypes/{{dataset}}.geno.tsv.gz"
    conda:
        "envs/tools.yaml"
    threads:
        config["resources"]["threads_plink"]
    params:
        prefix = f"{OUT}/genotypes/{{dataset}}"
    log:
        f"{OUT}/logs/export_genotypes/{{dataset}}.log"
    shell:
        """
        set -euo pipefail

        # --export-allele specifies which allele to count at each variant.
        # Using cohort-wide frequencies ensures consistent orientation
        # across cases, controls, and between PPMI and PEG cohorts.
        # --extract restricts to the one record chosen per chr:pos, so the
        # counted allele is always present in the record it is applied to.
        plink2 \
            --pfile          {params.prefix} \
            --extract        {input.keep_variants} \
            --export         Av \
            --export-allele  {input.export_allele} \
            --out            {params.prefix} \
            --threads        {threads} \
        2> {log}

        # --maj-ref in subset_genotypes ensures the major allele in this
        # subsample is always REF, so the counted ALT allele is always the
        # minor allele. The chr:pos dedup below is now only a backstop: the
        # --extract above already leaves one record per position. It must not
        # be relied on to resolve collisions, because it keeps whichever
        # record comes first rather than the best-allele one.
        awk -f scripts/reformat_traw.awk {params.prefix}.traw | \
            awk 'NR==1{{print; next}} !seen[$1]++{{print}}' | \
            bgzip -c > {output.tsv}

        rm -f {params.prefix}.traw
        n_snps=$(zcat {output.tsv} | tail -n +2 | wc -l)
        echo "SNPs exported: $n_snps" >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 5: Run MatrixEQTL per dataset
# Uses full PPMI SNP positions and probe lists.
# Meta-analysis uses a union approach so no pre-restriction is needed.
# ──────────────────────────────────────────────────────────────────────────────
rule run_mqtl:
    input:
        tsv        = f"{OUT}/genotypes/{{dataset}}.geno.tsv.gz",
        meth_file  = f"{OUT}/datasets/{{dataset}}/methylation.csv.gz",
        covar_file = f"{OUT}/datasets/{{dataset}}/covariates.csv",
        id_map     = f"{OUT}/datasets/{{dataset}}/id_map.csv",
        snp_pos    = f"{OUT}/positions/snp_positions.csv",
        cpg_pos    = f"{OUT}/positions/cpg_positions.csv",
        probe_list = f"{OUT}/datasets/retained_probes.txt"
    output:
        cis   = f"{OUT}/mqtl/{{dataset}}/cis_mqtls.txt",
        trans = f"{OUT}/mqtl/{{dataset}}/trans_mqtls.txt"
    conda:
        "envs/r_mqtl.yaml"
    threads:
        config["resources"]["threads_r"]
    log:
        f"{OUT}/logs/mqtl/{{dataset}}.log"
    shell:
        """
        mkdir -p {OUT}/mqtl/{wildcards.dataset}

        Rscript scripts/run_mqtl.R \
            --dataset    {wildcards.dataset} \
            --geno_tsv   {input.tsv} \
            --meth_file  {input.meth_file} \
            --covar_file {input.covar_file} \
            --id_map     {input.id_map} \
            --snp_pos    {input.snp_pos} \
            --cpg_pos    {input.cpg_pos} \
            --out_cis    {output.cis} \
            --out_trans  {output.trans} \
            --cis_dist   {config[matrixeqtl][cis_dist]} \
            --pval_cis   {config[matrixeqtl][pval_cis]} \
            --pval_trans {config[matrixeqtl][pval_trans]} \
            --threads    {threads} \
            --log        {log} \
        2>> {log}
        """
