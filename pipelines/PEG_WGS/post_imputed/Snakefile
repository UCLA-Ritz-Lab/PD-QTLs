# =============================================================================
# PEG Post-Imputation Pipeline
# Michigan Imputation Server — HRC r1.1 2016 (GRCh37/hg19)
#
# Input:  results/PEG_WGS/imputation_results/chr_<N>.zip  (one per chromosome, from MIS download)
# Output: results/peg_imputed_filtered.dose.vcf.gz  (analysis-ready dosages)
#         results/peg_imputed_filtered.dose.vcf.gz.tbi
#         results/peg_imputed.pgen / .psam / .pvar  (PLINK2 dosage format)
#         results/qc/post_imputation_report.txt
#
# Pipeline steps:
#   1. unzip_chrom      — decrypt and unzip MIS output per chromosome
#   2. filter_rsq       — retain variants with Rsq >= RSQ_MIN
#   3. concat_chroms    — merge filtered per-chrom VCFs into one
#   4. index_final      — tabix index the merged VCF
#   5. convert_plink2   — convert to PLINK2 dosage format for MatrixEQTL
#   6. qc_report        — summarise variant counts and Rsq distribution
# =============================================================================

# ── Config ────────────────────────────────────────────────────────────────────
import os

IMPUTED_DIR = "../../../results/PEG_WGS/imputation_results"     # directory containing chr_<N>.zip files from MIS
OUT         = "../../../results/PEG_WGS/post_imputed"
CHROMS      = list(range(1, 23))

# Imputation quality filter — 0.3 is standard minimum; raise to 0.8 for
# high-confidence variants only. HRC well-imputed variants typically Rsq > 0.8
RSQ_MIN = 0.3

# MIS zip password -- set via environment variable to avoid hardcoding
# Export before running: export MIS_PASSWORD="your_password_here"
MIS_PASSWORD = os.environ.get("MIS_PASSWORD", "")

# ── Targets ───────────────────────────────────────────────────────────────────
rule all:
    input:
        f"{OUT}/peg_imputed_filtered.dose.vcf.gz",
        f"{OUT}/peg_imputed_filtered.dose.vcf.gz.tbi",
        f"{OUT}/peg_imputed.pgen",
        f"{OUT}/qc/post_imputation_report.txt"


# ──────────────────────────────────────────────────────────────────────────────
# Step 1: Unzip per-chromosome MIS output
# MIS returns password-protected zips containing:
#   chr{N}.dose.vcf.gz
#   chr{N}.dose.vcf.gz.tbi
#   chr{N}.info.gz
# ──────────────────────────────────────────────────────────────────────────────
rule unzip_chrom:
    input:
        zip = f"{IMPUTED_DIR}/chr_{{chrom}}.zip"
    output:
        vcf  = temp(f"{OUT}/unzipped/chr{{chrom}}.dose.vcf.gz"),
        tbi  = temp(f"{OUT}/unzipped/chr{{chrom}}.dose.vcf.gz.tbi"),
        info = f"{OUT}/unzipped/chr{{chrom}}.info.gz"
    log:
        f"{OUT}/logs/unzip/chr{{chrom}}.log"
    conda:
        "envs/post_imputation.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {OUT}/unzipped

        # Extract dose.vcf.gz and info.gz only
        # (empiricalDose.vcf.gz contains genotype calls at array sites only -- not needed)
        unzip -P "$MIS_PASSWORD" -o {input.zip} \
            "chr{wildcards.chrom}.dose.vcf.gz" \
            "chr{wildcards.chrom}.info.gz" \
            -d {OUT}/unzipped/ \
        2> {log}

        if [[ ! -f {output.vcf} ]]; then
            echo "ERROR: expected {output.vcf} not found after unzip" >> {log}
            exit 1
        fi

        # No tbi in the zip — generate it
        echo "Indexing chr{wildcards.chrom}.dose.vcf.gz..." >> {log}
        tabix -p vcf {output.vcf} 2>> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 2: Filter by imputation quality (Rsq)
# The INFO field contains Rsq from minimac4.
# Also apply MAF filter here to drop very rare imputed variants.
# ──────────────────────────────────────────────────────────────────────────────
rule filter_rsq:
    input:
        vcf  = f"{OUT}/unzipped/chr{{chrom}}.dose.vcf.gz",
        tbi  = f"{OUT}/unzipped/chr{{chrom}}.dose.vcf.gz.tbi"
    output:
        vcf = temp(f"{OUT}/filtered/chr{{chrom}}.dose.vcf.gz"),
        tbi = temp(f"{OUT}/filtered/chr{{chrom}}.dose.vcf.gz.tbi")
    params:
        rsq_min = RSQ_MIN
    log:
        f"{OUT}/logs/filter_rsq/chr{{chrom}}.log"
    conda:
        "envs/post_imputation.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {OUT}/filtered

        echo "Filtering chr{wildcards.chrom} — Rsq >= {params.rsq_min}" 2> {log}

        bcftools view \
            --include 'INFO/R2 >= {params.rsq_min}' \
            --output-type z \
            --output {output.vcf} \
            {input.vcf} \
        2>> {log}

        tabix -p vcf {output.vcf} 2>> {log}

        n=$(bcftools stats {output.vcf} | grep "^SN.*number of SNPs" | cut -f4)
        echo "chr{wildcards.chrom}: $n variants retained after Rsq filter" >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 3: Concatenate all chromosomes into a single VCF
# ──────────────────────────────────────────────────────────────────────────────
rule concat_chroms:
    input:
        vcfs = expand(f"{OUT}/filtered/chr{{chrom}}.dose.vcf.gz", chrom=CHROMS),
        tbis = expand(f"{OUT}/filtered/chr{{chrom}}.dose.vcf.gz.tbi", chrom=CHROMS)
    output:
        vcf = f"{OUT}/peg_imputed_filtered.dose.vcf.gz"
    log:
        f"{OUT}/logs/concat_chroms.log"
    conda:
        "envs/post_imputation.yaml"
    threads: 4
    shell:
        """
        set -euo pipefail

        echo "Concatenating chromosomes 1-22..." 2> {log}

        bcftools concat \
            --allow-overlaps \
            --output-type z \
            --output {output.vcf} \
            --threads {threads} \
            {input.vcfs} \
        2>> {log}

        echo "Concatenation complete." >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 4: Index the merged VCF
# ──────────────────────────────────────────────────────────────────────────────
rule index_final:
    input:
        vcf = f"{OUT}/peg_imputed_filtered.dose.vcf.gz"
    output:
        tbi = f"{OUT}/peg_imputed_filtered.dose.vcf.gz.tbi"
    log:
        f"{OUT}/logs/index_final.log"
    conda:
        "envs/post_imputation.yaml"
    shell:
        """
        set -euo pipefail
        tabix -p vcf {input.vcf} 2> {log}
        echo "Index complete." >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 5: Convert to PLINK2 dosage format
# --import-dosage-certainty 0.0 retains all DS values
# Output .pgen/.psam/.pvar is the input format for the PEG mQTL pipeline
# ──────────────────────────────────────────────────────────────────────────────
rule convert_plink2:
    input:
        vcf = f"{OUT}/peg_imputed_filtered.dose.vcf.gz",
        tbi = f"{OUT}/peg_imputed_filtered.dose.vcf.gz.tbi"
    output:
        pgen = f"{OUT}/peg_imputed.pgen",
        psam = f"{OUT}/peg_imputed.psam",
        pvar = f"{OUT}/peg_imputed.pvar"
    params:
        prefix = f"{OUT}/peg_imputed"
    log:
        f"{OUT}/logs/convert_plink2.log"
    conda:
        "envs/post_imputation.yaml"
    threads: 4
    shell:
        """
        set -euo pipefail

        echo "Converting to PLINK2 dosage format..." 2> {log}

        plink2 \
            --vcf {input.vcf} dosage=DS \
            --double-id \
            --make-pgen \
            --out {params.prefix} \
            --threads {threads} \
        2>> {log}

        echo "PLINK2 conversion complete." >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 6: Post-imputation QC report
# Summarises variant counts, Rsq distribution, and per-chromosome breakdown
# using the .info.gz files returned by MIS
# ──────────────────────────────────────────────────────────────────────────────
rule qc_report:
    input:
        info_files = expand(f"{OUT}/unzipped/chr{{chrom}}.info.gz", chrom=CHROMS),
        mis_qc     = "../../../results/PEG_WGS/imputation_results/qc_report.txt",
        final_vcf  = f"{OUT}/peg_imputed_filtered.dose.vcf.gz"
    output:
        report = f"{OUT}/qc/post_imputation_report.txt"
    log:
        f"{OUT}/logs/qc_report.log"
    conda:
        "envs/post_imputation.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {OUT}/qc

        python scripts/post_imputation_report.py \
            --info_dir {OUT}/unzipped \
            --mis_qc {input.mis_qc} \
            --final_vcf {input.final_vcf} \
            --rsq_min {RSQ_MIN} \
            --out {output.report} \
        2> {log}

        cat {output.report}
        """
