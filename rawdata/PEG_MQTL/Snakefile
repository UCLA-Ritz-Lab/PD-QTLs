# ──────────────────────────────────────────────────────────────────────────────
# PEG mQTL Pipeline
# PEG1 + PEG2 methylation + genotypes → stratified mQTLs → meta-analysis
#
# Steps:
#   1. filter_imputed     — bcftools MAF >= 0.05 + Rsq >= 0.8 pre-filter
#   2. prepare_datasets   — load methylation, match IDs, filter probes
#   3. extract_positions  — SNP and CpG positions for MatrixEQTL
#   4. subset_genotypes   — PLINK2 --keep per dataset
#   5. export_genotypes   — PLINK2 SNP-major dosage export (avoids fread OOM)
#   6. run_mqtl           — MatrixEQTL cis + trans per dataset
# ──────────────────────────────────────────────────────────────────────────────

configfile: "config.yaml"

OUT          = config["out_dir"]
DATASETS     = list(config["datasets"].keys())
FILTERED_VCF = f"{OUT}/genotypes/peg_imputed_maf05_rsq08.vcf.gz"
# ──────────────────────────────────────────────────────────────────────────────
rule all:
    input:
        # cis mQTL results per dataset — final outputs for this pipeline
        expand("{out}/mqtl/{dataset}/cis_mqtls.txt",
               out=OUT, dataset=DATASETS),
        expand("{out}/mqtl/{dataset}/trans_mqtls.txt",
               out=OUT, dataset=DATASETS)



# ──────────────────────────────────────────────────────────────────────────────
# Step 1: Pre-filter imputed VCF by Rsq and MAF
# Reduces ~25M imputed variants to ~8-10M well-imputed common variants,
# making downstream PLINK2 and MatrixEQTL steps tractable on a workstation.
# MAF >= 0.05 and Rsq >= 0.8 are standard thresholds for mQTL analysis.
# ──────────────────────────────────────────────────────────────────────────────
rule filter_imputed:
    input:
        vcf = config["data"]["vcf"]
    output:
        vcf = FILTERED_VCF,
        tbi = f"{FILTERED_VCF}.tbi"
    params:
        min_r2  = config["imputation"]["min_r2"],
        min_maf = config["imputation"]["min_maf"]
    conda:
        "envs/tools.yaml"
    log:
        f"{OUT}/logs/filter_imputed.log"
    shell:
        """
        set -euo pipefail
        mkdir -p {OUT}/genotypes

        echo "Filtering imputed VCF: Rsq >= {params.min_r2}, MAF >= {params.min_maf}" 2> {log}

        bcftools view \
            --include 'INFO/R2 >= {params.min_r2} && INFO/MAF >= {params.min_maf}' \
            --output-type z \
            --output {output.vcf} \
            {input.vcf} \
        2>> {log}

        tabix -p vcf {output.vcf} 2>> {log}

        n=$(bcftools stats {output.vcf} | grep "^SN.*number of SNPs" | cut -f4)
        echo "Variants retained: $n" >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 2: Prepare datasets
# One R script processes all datasets at once (all share the same
# methylation data load — splitting would reload large RData files 3x)
# ──────────────────────────────────────────────────────────────────────────────
rule prepare_datasets:
    input:
        meth_peg1        = config["data"]["meth_peg1"],
        meth_peg2        = config["data"]["meth_peg2"],
        sentrix_map_peg1 = config["data"]["sentrix_map_peg1"],
        sentrix_map_peg2 = config["data"]["sentrix_map_peg2"],
        covar_peg1       = config["data"]["covar_peg1"],
        covar_peg2       = config["data"]["covar_peg2"],
        gwas_linkage     = config["data"]["gwas_linkage"],
        vcf              = FILTERED_VCF
    output:
        probe_list = f"{OUT}/datasets/retained_probes.txt",
        # Per-dataset outputs declared as a group
        meth_files = expand("{out}/datasets/{dataset}/methylation.csv.gz",
                            out=OUT, dataset=DATASETS),
        covar_files = expand("{out}/datasets/{dataset}/covariates.csv",
                             out=OUT, dataset=DATASETS),
        keep_files  = expand("{out}/datasets/{dataset}/geno_keep.txt",
                             out=OUT, dataset=DATASETS),
        id_maps     = expand("{out}/datasets/{dataset}/id_map.csv",
                             out=OUT, dataset=DATASETS)
    conda:
        "envs/r_mqtl.yaml"
    threads:
        config["resources"]["threads_r"]
    log:
        f"{OUT}/logs/prepare_datasets.log"
    shell:
        """
        Rscript scripts/prepare_datasets.R \
            --meth_peg1        {input.meth_peg1} \
            --meth_peg2        {input.meth_peg2} \
            --sentrix_map_peg1 {input.sentrix_map_peg1} \
            --sentrix_map_peg2 {input.sentrix_map_peg2} \
            --covar_peg1       {input.covar_peg1} \
            --covar_peg2       {input.covar_peg2} \
            --gwas_linkage     {input.gwas_linkage} \
            --vcf              {input.vcf} \
            --out_dir          {OUT} \
            --min_sd           {config[filters][min_sd]} \
            --max_na_frac      {config[filters][max_na_fraction]} \
            --log              {log} \
        2>> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 3: Extract SNP and CpG positions
# Needs a QC-filtered .pvar from any dataset — use peg1_cases as reference
# ──────────────────────────────────────────────────────────────────────────────
rule extract_positions:
    input:
        keep_file  = f"{OUT}/datasets/peg1_cases/geno_keep.txt",
        probe_list = f"{OUT}/datasets/retained_probes.txt",
        vcf        = FILTERED_VCF
    output:
        snp_pos = f"{OUT}/positions/snp_positions.csv",
        cpg_pos = f"{OUT}/positions/cpg_positions.csv",
        pvar    = f"{OUT}/positions/reference.pvar"
    conda:
        "envs/r_mqtl.yaml"
    threads:
        config["resources"]["threads_plink"]
    log:
        f"{OUT}/logs/extract_positions.log"
    shell:
        """
        set -euo pipefail

        # Generate a reference .pvar from the full VCF with QC filters
        plink2 \
            --vcf   {input.vcf} dosage=DS \
            --keep  {input.keep_file} \
            --maf   {config[plink][maf]} \
            --geno  {config[plink][geno]} \
            --hwe   {config[plink][hwe]} \
            --max-alleles 2 \
            --snps-only \
            --set-missing-var-ids '@:#:$r:$a' \
            --new-id-max-allele-len 50 missing \
            --no-psam-pheno \
            --make-just-pvar \
            --out   {OUT}/positions/reference \
            --threads {threads} \
        2>> {log}

        Rscript scripts/extract_positions.R \
            --pvar_file   {output.pvar} \
            --probe_list  {input.probe_list} \
            --out_snp_pos {output.snp_pos} \
            --out_cpg_pos {output.cpg_pos} \
            --log         {log} \
        2>> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 4: Subset genotypes per dataset (PLINK2 --keep)
# ──────────────────────────────────────────────────────────────────────────────
rule subset_genotypes:
    input:
        vcf       = FILTERED_VCF,
        keep_file = f"{OUT}/datasets/{{dataset}}/geno_keep.txt"
    output:
        pgen = f"{OUT}/genotypes/{{dataset}}.pgen",
        psam = f"{OUT}/genotypes/{{dataset}}.psam",
        pvar = f"{OUT}/genotypes/{{dataset}}.pvar"
    conda:
        "envs/tools.yaml"
    threads:
        config["resources"]["threads_plink"]
    params:
        prefix = f"{OUT}/genotypes/{{dataset}}"
    log:
        f"{OUT}/logs/subset_genotypes/{{dataset}}.log"
    shell:
        """
        set -euo pipefail

        plink2 \
            --vcf  {input.vcf} dosage=DS \
            --keep {input.keep_file} \
            --maf  {config[plink][maf]} \
            --geno {config[plink][geno]} \
            --mind {config[plink][mind]} \
            --hwe  {config[plink][hwe]} \
            --max-alleles 2 \
            --snps-only \
            --set-missing-var-ids '@:#:$r:$a' \
            --new-id-max-allele-len 50 missing \
            --no-psam-pheno \
            --make-pgen \
            --out  {params.prefix} \
            --threads {threads} \
        2> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 5: Export genotypes in SNP-major format for MatrixEQTL
# --export Av writes SNPs as rows, samples as columns -- no in-R transpose.
# This avoids the segfault from fread + t() on a 5GB sample-major .raw file.
# Output .geno.tsv.gz is loaded directly by SlicedData$LoadFile in run_mqtl.R.
# ──────────────────────────────────────────────────────────────────────────────
rule export_genotypes:
    input:
        pgen = f"{OUT}/genotypes/{{dataset}}.pgen",
        psam = f"{OUT}/genotypes/{{dataset}}.psam",
        pvar = f"{OUT}/genotypes/{{dataset}}.pvar"
    output:
        tsv = f"{OUT}/genotypes/{{dataset}}.geno.tsv.gz"
    conda:
        "envs/tools.yaml"
    threads:
        config["resources"]["threads_plink"]
    params:
        prefix = f"{OUT}/genotypes/{{dataset}}"
    log:
        f"{OUT}/logs/export_genotypes/{{dataset}}.log"
    shell:
        """
        set -euo pipefail

        # Export variant-major additive dosage (SNPs x samples)
        # .traw columns: CHR SNP CM POS COUNTED ALT sample1 sample2 ...
        plink2 \
            --pfile   {params.prefix} \
            --export  Av \
            --out     {params.prefix} \
            --threads {threads} \
        2> {log}

        # Reformat .traw to MatrixEQTL SNP-major TSV via external awk script
        # (avoids quoting/escape issues with inline awk in Snakemake shell blocks)
        awk -f scripts/reformat_traw.awk {params.prefix}.traw | bgzip -c > {output.tsv}

        rm -f {params.prefix}.traw
        echo "SNPs exported: $(zcat {output.tsv} | tail -n +2 | wc -l)" >> {log}
        """


# ──────────────────────────────────────────────────────────────────────────────
# Step 6: Run MatrixEQTL per dataset
# ──────────────────────────────────────────────────────────────────────────────
rule run_mqtl:
    input:
        tsv        = f"{OUT}/genotypes/{{dataset}}.geno.tsv.gz",
        meth_file  = f"{OUT}/datasets/{{dataset}}/methylation.csv.gz",
        covar_file = f"{OUT}/datasets/{{dataset}}/covariates.csv",
        id_map     = f"{OUT}/datasets/{{dataset}}/id_map.csv",
        snp_pos    = f"{OUT}/positions/snp_positions.csv",
        cpg_pos    = f"{OUT}/positions/cpg_positions.csv"
    output:
        cis   = f"{OUT}/mqtl/{{dataset}}/cis_mqtls.txt",
        trans = f"{OUT}/mqtl/{{dataset}}/trans_mqtls.txt"
    conda:
        "envs/r_mqtl.yaml"
    threads:
        config["resources"]["threads_r"]
    log:
        f"{OUT}/logs/mqtl/{{dataset}}.log"
    shell:
        """
        mkdir -p {OUT}/mqtl/{wildcards.dataset}

        Rscript scripts/run_mqtl.R \
            --dataset     {wildcards.dataset} \
            --geno_tsv    {input.tsv} \
            --meth_file   {input.meth_file} \
            --covar_file  {input.covar_file} \
            --id_map      {input.id_map} \
            --snp_pos     {input.snp_pos} \
            --cpg_pos     {input.cpg_pos} \
            --out_cis     {output.cis} \
            --out_trans   {output.trans} \
            --cis_dist    {config[matrixeqtl][cis_dist]} \
            --pval_cis    {config[matrixeqtl][pval_cis]} \
            --pval_trans  {config[matrixeqtl][pval_trans]} \
            --threads     {threads} \
            --log         {log} \
        2>> {log}
        """



